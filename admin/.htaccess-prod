<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
</IfModule>

RewriteEngine On
RewriteBase /

# Allow access only from the specified subdomain
# RewriteCond %{HTTP_HOST} !^(www\.)?cms\.stpaulsministry\.org$ 
# RewriteRule ^ - [F]

RewriteRule ^(api.php)($|/) - [L]

RewriteCond %{HTTPS} off
RewriteRule ^(.*) https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} !^www\.
RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d [NC]
RewriteCond %{REQUEST_FILENAME} !-f [NC]
RewriteCond %{REQUEST_URI} /+[^\.]+$

RewriteRule ^(.+[^/])$ %{REQUEST_URI}/ [R=301,L]


RewriteRule ^([a-zA-Z0-9-z\-\_]+)/$ index.php?view=$1 [QSA,L]
RewriteRule ^([a-zA-Z0-9-z\-\_]+)/([a-zA-Z0-9-z\-\_]+)/$ index.php?view=$1&action=$2 [QSA,L] 
RewriteRule ^([a-zA-Z0-9-z\-\_]+)/([a-zA-Z0-9-z\-\_]+)/([a-zA-Z0-9-z\-\_]+)/$ index.php?view=$1&action=$2&value=$3 [QSA,L] 

RewriteRule ^$ index.php [QSA,L]

